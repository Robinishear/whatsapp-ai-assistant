generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id            String         @id @default(cuid())
  waId          String         @unique // WhatsApp identifier (phone number)
  displayName   String?
  status        String         @default("active")
  priority      String         @default("normal")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model Conversation {
  id        String    @id @default(cuid())
  contact   Contact   @relation(fields: [contactId], references: [id])
  contactId String
  state     String    @default("open") // open | waiting_approval | closed
  mode      String    @default("auto") // auto | manual
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String        @id @default(cuid())
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      String // inbound | outbound
  waMessageId    String        @unique
  text           String
  status         String        @default("received") // received | draft | approved | sent | rejected
  createdAt      DateTime      @default(now())
  analysis       AIAnalysis?
}

model AIAnalysis {
  id         String   @id @default(cuid())
  message    Message  @relation(fields: [messageId], references: [id])
  messageId  String   @unique
  intent     String
  risk       String // low | medium | high
  confidence Float
  provider   String
  model      String?
  decision   String // AUTO_REPLY | DRAFT_FOR_APPROVAL | ALERT
  reason     String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  status    String   @default("sent") // sent | failed
  payload   Json
  createdAt DateTime @default(now())
}

model SystemSetting {
  id               String   @id @default(cuid())
  activeAiProvider String
  activeAiModel    String?
  updatedAt        DateTime @updatedAt
}

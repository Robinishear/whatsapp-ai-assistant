{
  "name": "whatsapp-ai-assistant",
  "version": "1.0.0",
  "description": "AI-powered personal WhatsApp Business assistant with policy-engine controlled auto-replies",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/knowledge && cp src/knowledge/*.json dist/knowledge/",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "express": "^4.21.0",
    "zod": "^3.23.8",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "prisma": "^5.20.0",
    "vitest": "^2.1.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "pino-pretty": "^11.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}